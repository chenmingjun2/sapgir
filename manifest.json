{
  "manifest_version": 3,
  "name": "Sapgir",
  "short_name": "Sapgir",
  "version": "1.4.2",
  "description": "兼容 OpenAI Chat Completions 协议的自带 Key AI 聊天客户端，支持服务端联网搜索、深度思考与数学公式渲染。",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "打开 Sapgir",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
